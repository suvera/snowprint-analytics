# Snowprint settings for: docker run --env-file .env ...
# Copy to .env and edit: cp .env.example .env
# Write values without quotes (docker passes them literally). Never commit .env.

# Your PostgreSQL (15+). For PostgreSQL on the Docker host use host.docker.internal
# and run the container with --add-host=host.docker.internal:host-gateway.
SNOWPRINT_DB_URL=pgsql:host=host.docker.internal;port=5432;dbname=snowprint
SNOWPRINT_DB_USER=snowprint
SNOWPRINT_DB_PASSWORD=change-me

# Optional. Behind a reverse proxy that sets X-Forwarded-For, take the visitor IP from it.
# SNOWPRINT_TRUST_PROXY=true
# Optional. Count visits from browsers that send "DNT: 1" (default: they are dropped).
# SNOWPRINT_RESPECT_DNT=false
# Optional debugging aids: one log line per request, indented JSON responses.
# SNOWPRINT_REQUEST_TRACE=true
# SNOWPRINT_JSON_PRETTY=true
# Optional. Public tracking URL used in the dashboard's snippet (default: the dashboard's address).
# SNOWPRINT_PUBLIC_URL=https://stats.example.com
# Optional. Email invite links through your SMTP server (else admins copy them).
# SNOWPRINT_SMTP_HOST=smtp.example.com
# SNOWPRINT_SMTP_PORT=587
# SNOWPRINT_SMTP_ENCRYPTION=starttls
# SNOWPRINT_SMTP_USER=stats@example.com
# SNOWPRINT_SMTP_PASSWORD=change-me
# SNOWPRINT_SMTP_FROM=stats@example.com
# Optional. Locations: download DB-IP Lite when the container starts ...
# SNOWPRINT_GEOIP_DOWNLOAD=dbip-city-lite
# ... or use your own .mmdb mounted into the container.
# SNOWPRINT_GEOIP_DB=/geo/dbip-city-lite.mmdb
